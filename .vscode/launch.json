{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch file",
			"type": "go",
			"request": "launch",
			"mode": "debug",
			"program": "${file}"
		},
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/vscode"
			],
			"preLaunchTask": "npm: build - vscode",
			"outFiles": [
				"${workspaceFolder}/vscode/dist/*.js"
			],
			"sourceMaps": true
		}
	]
}
