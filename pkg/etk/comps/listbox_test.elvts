## left and right (unhandled) ##
~> setup [&items=(etk:-string-items foo bar lorem)]
~> send &show-reaction [Left]
Unused
~> send &show-reaction [Right]
Unused

//////////////////////////
# multi-column rendering #
//////////////////////////

## empty items ##
~> setup [&multi-column=$true &items=(etk:-string-items)]
   render
┌────────────────────────────────────────┐
│(no item)                               │
│ ̅̂                                       │
└────────────────────────────────────────┘

## area styling ##
~> setup [&multi-column=$true &items=[
     &len={|| num 8}
     &get={|i| put unused}
     &show={|i|
       put item$i
       if (== $i 2) {
         -extra:styling 'magenta inverse'
       } else {
         -extra:styling ''
       }
     }]]
   render
┌────────────────────────────────────────┐
│item0  item2  item4  item6              │
│#̅̂####  WWWWW                            │
│item1  item3  item5  item7              │
│                                        │
└────────────────────────────────────────┘

## rendering all items when one row fits ##
~> setup [&multi-column=$true &items=(etk:-string-items foo bar lorem ipsum)]
   render
┌────────────────────────────────────────┐
│foo  bar  lorem  ipsum                  │
│#̅̂##                                     │
└────────────────────────────────────────┘

## rendering all items when multiple rows are needed ##
~> setup [&multi-column=$true &items=(etk:-string-items (range 8 | each {|i| put item$i}))]
   render
┌────────────────────────────────────────┐
│item0  item2  item4  item6              │
│#̅̂####                                   │
│item1  item3  item5  item7              │
│                                        │
└────────────────────────────────────────┘

## rendering with scrollbar ##
~> setup [&multi-column=$true &items=(etk:-string-items (range 20 | each {|i| put item$i}))]
   render &height=3
┌────────────────────────────────────────┐
│item0  item2  item4  item6  item8  item1│
│#̅̂####                                   │
│item1  item3  item5  item7  item9  item1│
│                                        │
│                        ━━━━━━━━━━━━━━━━│
│WWWWWWWWWWWWWWWWWWWWWWWWMMMMMMMMMMMMMMMM│
└────────────────────────────────────────┘

