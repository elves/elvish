//////////////////
# custom binding #
//////////////////

~> setup [&items=(etk:-string-items foo bar lorem)
          &binding={|ctx ev|
            if (eq (etk:-ev-to-string $ev) x) {
              $ctx[set] selected (num 1)
              put $etk:consumed
            } else {
              put $etk:unused
            }
          }]
   render
┌────────────────────────────────────────┐
│foo                                     │
│#̅̂#######################################│
│bar                                     │
│                                        │
│lorem                                   │
│                                        │
└────────────────────────────────────────┘
~> send x
   render
┌────────────────────────────────────────┐
│foo                                     │
│                                        │
│bar                                     │
│#̅̂#######################################│
│lorem                                   │
│                                        │
└────────────────────────────────────────┘
