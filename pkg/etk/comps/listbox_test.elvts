//each:list-box-fixture
//each:extra-bindings
//each:eval use etk

///////////////////////////
# single-column rendering #
///////////////////////////

## empty items ##
~> setup [&items=(etk:-string-items)]
   render
┌────────────────────────────────────────┐
│(no item)                               │
│ ̅̂                                       │
└────────────────────────────────────────┘

## rendering all items ##
~> setup [&items=(etk:-string-items foo bar baz)]
   render &height=10
┌────────────────────────────────────────┐
│foo                                     │
│#̅̂#######################################│
│bar                                     │
│                                        │
│baz                                     │
│                                        │
└────────────────────────────────────────┘

## area styling ##
~> setup [&items=[
     &len={|| num 2}
     &get={|i| put unused}
     &show={|i|
       if (== $i 0) {
         put "foo"; -extra:styling ''
       } else {
         put "bar\nbaz"; -extra:styling 'magenta inverse'
       }
     }]]
   render
┌────────────────────────────────────────┐
│foo                                     │
│#̅̂#######################################│
│bar                                     │
│WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW│
│baz                                     │
│WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW│
└────────────────────────────────────────┘

## cropping long lines ##
~> setup [&items=(etk:-string-items foo this-is-a-very-long-item baz)]
   render &width=10 &height=10
┌──────────┐
│foo       │
│#̅̂#########│
│this-is-a-│
│          │
│baz       │
│          │
└──────────┘

## rendering a subset of items, with scrollbar, when viewport is short ##
~> setup [&items=(etk:-string-items (range 10 | each $to-string~))]
   render &height=5
┌────────────────────────────────────────┐
│0                                       │
│#̅̂######################################W│
│1                                       │
│                                       W│
│2                                       │
│                                       W│
│3                                      ││
│                                       M│
│4                                      ││
│                                       M│
└────────────────────────────────────────┘

## also showing scrollbar when the last item has lines outside the viewport ##
~> setup [&items=(etk:-string-items foo "bar\nbaz")]
   render &height=2
┌────────────────────────────────────────┐
│foo                                     │
│#̅̂######################################W│
│bar                                     │
│                                       W│
└────────────────────────────────────────┘

## left and right padding ##
~> setup [&items=(etk:-string-items foo bar rather-long) &left-padding=1 &right-padding=2]
   render &width=10
┌──────────┐
│ foo      │
│#̅̂#########│
│ bar      │
│          │
│ rather-  │
│          │
└──────────┘


