//each:combo-box-fixture
//each:extra-bindings
//each:eval use etk
//each:eval var gen-just-foo = {|q| etk:-string-items foo; put 0}

/////////////
# rendering #
/////////////

## empty query and empty list ##
~> setup [&gen-list=$gen-just-foo]
   render
┌────────────────────────────────────────┐
│                                        │
│ ̅̂                                       │
│foo                                     │
│########################################│
└────────────────────────────────────────┘

## hide empty query ##
~> setup [&gen-list=$gen-just-foo &hide-empty-query]
   render
┌────────────────────────────────────────┐
│foo                                     │
│#̅̂#######################################│
└────────────────────────────────────────┘

////////////
# reacting #
////////////

## query event and regeneration ##
~> setup [&gen-list={|q| etk:-string-items $q; put 0}]
   render
┌────────────────────────────────────────┐
│                                        │
│ ̅̂                                       │
└────────────────────────────────────────┘
~> send f
   render
┌────────────────────────────────────────┐
│f                                       │
│  ̅̂                                      │
│f                                       │
│########################################│
└────────────────────────────────────────┘

## list event ##
~> setup [&gen-list={|q| etk:-string-items foo bar baz; put 0}]
   render
┌────────────────────────────────────────┐
│                                        │
│ ̅̂                                       │
│foo                                     │
│########################################│
│bar                                     │
│                                        │
│baz                                     │
│                                        │
└────────────────────────────────────────┘
~> send [Down]
   render
┌────────────────────────────────────────┐
│                                        │
│ ̅̂                                       │
│foo                                     │
│                                        │
│bar                                     │
│########################################│
│baz                                     │
│                                        │
└────────────────────────────────────────┘

## custom binding ##
~> setup [&gen-list={|q| etk:-string-items foo bar baz; put 0}
          &binding={|ctx ev|
            if (eq (etk:-ev-to-string $ev) "x") {
              $ctx[set] list/selected (num 1)
              put $etk:consumed
            } else {
              put $etk:unused
            }
          }]
   render
┌────────────────────────────────────────┐
│                                        │
│ ̅̂                                       │
│foo                                     │
│########################################│
│bar                                     │
│                                        │
│baz                                     │
│                                        │
└────────────────────────────────────────┘
~> send x
   render
┌────────────────────────────────────────┐
│                                        │
│ ̅̂                                       │
│foo                                     │
│                                        │
│bar                                     │
│########################################│
│baz                                     │
│                                        │
└────────────────────────────────────────┘
~> send y
   render
┌────────────────────────────────────────┐
│y                                       │
│  ̅̂                                      │
│foo                                     │
│########################################│
│bar                                     │
│                                        │
│baz                                     │
│                                        │
└────────────────────────────────────────┘
