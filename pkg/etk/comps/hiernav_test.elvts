//each:hier-nav-fixture
//each:map-hier-in-global
//each:eval use etk

/////////////////////////////////
# rendering and some navigation #
/////////////////////////////////

## top-level leaf item ##
~> setup [&hier=(map-hier [&pkg=[&eval=[&a.go=lorem &b.go=ipsum] &pkg.go=foobar] &readme=Hello])]
   render
┌────────────────────────────────────────┐
│      pkg            eval               │
│     W̅̂WWWWWWWWWWWWW WWWWWWWWWWWWWWWWWWWW│
│      readme         pkg.go             │
│                                        │
└────────────────────────────────────────┘

## top-level leaf item ##
~> setup [&hier=(map-hier [&pkg=[&eval=[&a.go=lorem &b.go=ipsum] &pkg.go=foobar] &readme=Hello])]
   send [Down]
   render
┌────────────────────────────────────────┐
│      pkg           Hello               │
│     M̅̂MMMMMMMMMMMMM                     │
│      readme                            │
│     ##############                     │
└────────────────────────────────────────┘

## inner-level container item ##
~> setup [&hier=(map-hier [&pkg=[&eval=[&a.go=lorem &b.go=ipsum] &pkg.go=foobar] &readme=Hello])]
   send [Right]
   render
┌────────────────────────────────────────┐
│ pk   eval           a.go               │
│WWWW W̅̂WWWWWWWWWWWWW ####################│
│ re   pkg.go         b.go               │
│                                        │
└────────────────────────────────────────┘

## inner-level leaf item ##
~> setup [&hier=(map-hier [&pkg=[&eval=[&a.go=lorem &b.go=ipsum] &pkg.go=foobar] &readme=Hello])]
   send [Right Down]
   render
┌────────────────────────────────────────┐
│ pk   eval          foobar              │
│WWWW M̅̂MMMMMMMMMMMMM                     │
│ re   pkg.go                            │
│     ##############                     │
└────────────────────────────────────────┘

///////////////////
# more navigation #
///////////////////

## navigation downwards and upwards ##
~> setup [&hier=(map-hier [&pkg=[&eval=[&a.go=lorem &b.go=ipsum] &pkg.go=foobar] &readme=Hello])]
   render
┌────────────────────────────────────────┐
│      pkg            eval               │
│     W̅̂WWWWWWWWWWWWW WWWWWWWWWWWWWWWWWWWW│
│      readme         pkg.go             │
│                                        │
└────────────────────────────────────────┘
~> send [Down]
   render
┌────────────────────────────────────────┐
│      pkg           Hello               │
│     M̅̂MMMMMMMMMMMMM                     │
│      readme                            │
│     ##############                     │
└────────────────────────────────────────┘
~> send [Up]
   render
┌────────────────────────────────────────┐
│      pkg            eval               │
│     W̅̂WWWWWWWWWWWWW WWWWWWWWWWWWWWWWWWWW│
│      readme         pkg.go             │
│                                        │
└────────────────────────────────────────┘

## navigation rightwards and leftwards ##
~> setup [&hier=(map-hier [&pkg=[&eval=[&a.go=lorem &b.go=ipsum] &pkg.go=foobar] &readme=Hello])]
   render
┌────────────────────────────────────────┐
│      pkg            eval               │
│     W̅̂WWWWWWWWWWWWW WWWWWWWWWWWWWWWWWWWW│
│      readme         pkg.go             │
│                                        │
└────────────────────────────────────────┘
~> send [Right]
   render
┌────────────────────────────────────────┐
│ pk   eval           a.go               │
│WWWW W̅̂WWWWWWWWWWWWW ####################│
│ re   pkg.go         b.go               │
│                                        │
└────────────────────────────────────────┘
~> send [Right]
   render
┌────────────────────────────────────────┐
│ ev   a.go          lorem               │
│WWWW #̅̂#############                     │
│ pk   b.go                              │
│                                        │
└────────────────────────────────────────┘
~> send [Left]
   render
┌────────────────────────────────────────┐
│ pk   eval           a.go               │
│WWWW W̅̂WWWWWWWWWWWWW ####################│
│ re   pkg.go         b.go               │
│                                        │
└────────────────────────────────────────┘
~> send [Left]
   render
┌────────────────────────────────────────┐
│      pkg            eval               │
│     W̅̂WWWWWWWWWWWWW WWWWWWWWWWWWWWWWWWWW│
│      readme         pkg.go             │
│                                        │
└────────────────────────────────────────┘
~> send [Left] # no effect
   render
┌────────────────────────────────────────┐
│      pkg            eval               │
│     W̅̂WWWWWWWWWWWWW WWWWWWWWWWWWWWWWWWWW│
│      readme         pkg.go             │
│                                        │
└────────────────────────────────────────┘

///////////
# no hier #
///////////

~> setup [&]
   render
┌────────────────────────────────────────┐
│     hier is nil                        │
│      ̅̂                                  │
└────────────────────────────────────────┘
~> send x # no effect
   render
┌────────────────────────────────────────┐
│     hier is nil                        │
│      ̅̂                                  │
└────────────────────────────────────────┘
