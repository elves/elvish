//each:hier-nav-fixture
//each:map-hier-in-global
//each:eval use etk

/////////////
# rendering #
/////////////

## top-level container item ##
~> setup [&hier=(map-hier [&a=[&x=foo &y=bar] &b=ipsum])]
   render
┌────────────────────────────────────────┐
│                                        │
│      ̅̂                                  │
│      a              x                  │
│     WWWWWWWWWWWWWW ####################│
│      b              y                  │
│                                        │
└────────────────────────────────────────┘

## top-level leaf item ##
~> setup [&hier=(map-hier [&a=[&x=foo &y=bar] &b=ipsum])]
   send [Down]
   render
┌────────────────────────────────────────┐
│                    ipsum               │
│      ̅̂                                  │
│      a                                 │
│     MMMMMMMMMMMMMM                     │
│      b                                 │
│     ##############                     │
└────────────────────────────────────────┘
